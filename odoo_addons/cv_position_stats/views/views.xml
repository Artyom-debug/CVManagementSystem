<odoo>
    <record id="view_cv_position_import_list" model="ir.ui.view">
        <field name="name">cv.position.import.list</field>
        <field name="model">cv.position.import</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="published_cv_count"/>
                <field name="source_created_at"/>
                <field name="imported_at"/>
            </list>
        </field>
    </record>

    <record id="view_cv_position_attribute_stat_form" model="ir.ui.view">
        <field name="name">cv.position.attribute.stat.form</field>
        <field name="model">cv.position.attribute.stat</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_attribute_id"/>
                        <field name="attribute_type"/>
                        <field name="display_order"/>
                        <field name="filled_count"/>
                    </group>
                    <group string="Numeric" invisible="attribute_type != 'Numeric' or filled_count == 0">
                        <field name="numeric_minimum"/>
                        <field name="numeric_maximum"/>
                        <field name="numeric_average"/>
                    </group>
                    <group string="Dates" invisible="attribute_type != 'Date' or filled_count == 0">
                        <field name="earliest_date"/>
                        <field name="latest_date"/>
                    </group>
                    <group string="Periods" invisible="attribute_type != 'Period' or filled_count == 0">
                        <field name="earliest_period_start"/>
                        <field name="latest_period_end"/>
                    </group>
                    <group string="Checkbox" invisible="attribute_type != 'Checkbox'">
                        <field name="true_count"/>
                        <field name="false_count"/>
                    </group>
                    <field name="top_value_ids" invisible="attribute_type not in ('String', 'Text', 'Dropdown')">
                        <list create="false" edit="false" delete="false">
                            <field name="name"/>
                            <field name="count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cv_position_import_form" model="ir.ui.view">
        <field name="name">cv.position.import.form</field>
        <field name="model">cv.position.import</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_position_id"/>
                        <field name="description"/>
                        <field name="published_cv_count"/>
                        <field name="source_created_at"/>
                        <field name="imported_at"/>
                    </group>
                    <field name="attribute_stat_ids">
                        <list create="false" edit="false" delete="false">
                            <field name="display_order"/>
                            <field name="name"/>
                            <field name="attribute_type"/>
                            <field name="filled_count"/>
                        </list>
                        <form create="false" edit="false" delete="false">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="attribute_type"/>
                                    <field name="filled_count"/>
                                    <field name="numeric_minimum" invisible="attribute_type != 'Numeric' or filled_count == 0"/>
                                    <field name="numeric_maximum" invisible="attribute_type != 'Numeric' or filled_count == 0"/>
                                    <field name="numeric_average" invisible="attribute_type != 'Numeric' or filled_count == 0"/>
                                    <field name="earliest_date" invisible="attribute_type != 'Date' or filled_count == 0"/>
                                    <field name="latest_date" invisible="attribute_type != 'Date' or filled_count == 0"/>
                                    <field name="earliest_period_start" invisible="attribute_type != 'Period' or filled_count == 0"/>
                                    <field name="latest_period_end" invisible="attribute_type != 'Period' or filled_count == 0"/>
                                    <field name="true_count" invisible="attribute_type != 'Checkbox'"/>
                                    <field name="false_count" invisible="attribute_type != 'Checkbox'"/>
                                </group>
                                <field name="top_value_ids" invisible="attribute_type not in ('String', 'Text', 'Dropdown')">
                                    <list create="false" edit="false" delete="false">
                                        <field name="name"/>
                                        <field name="count"/>
                                    </list>
                                </field>
                            </sheet>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cv_position_import_wizard_form" model="ir.ui.view">
        <field name="name">cv.position.import.wizard.form</field>
        <field name="model">cv.position.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Position Statistics">
                <group>
                    <field name="api_token" password="True"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cv_position_imports" model="ir.actions.act_window">
        <field name="name">Imported Positions</field>
        <field name="res_model">cv.position.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_cv_position_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Position Statistics</field>
        <field name="res_model">cv.position.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cv_position_stats_root" name="CV Position Statistics" sequence="20"
              groups="cv_position_stats.group_cv_position_stats_viewer,base.group_system"/>
    <menuitem id="menu_cv_position_imports" name="Imported Positions"
              parent="menu_cv_position_stats_root" action="action_cv_position_imports" sequence="10"
              groups="cv_position_stats.group_cv_position_stats_viewer,base.group_system"/>
    <menuitem id="menu_cv_position_import_wizard" name="Import by Token"
              parent="menu_cv_position_stats_root" action="action_cv_position_import_wizard"
              groups="base.group_system" sequence="20"/>
</odoo>
